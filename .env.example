# Gemini MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# Gemini MCP Server Environment Variables

# Required: Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Logging level (default: INFO)
LOG_LEVEL=INFO

# Optional: Max tokens for generation (default: 8192)
MAX_TOKENS=8192

# Optional: Temperature for generation (default: 0.7)
TEMPERATURE=0.7

# Optional: Server configuration
SERVER_NAME=gemini-mcp
SERVER_VERSION=1.0.0

# Optional: Maximum tokens for responses (default: 8192)
MAX_TOKENS=8192

# Optional: Temperature for responses (default: 0.7)
TEMPERATURE=0.7